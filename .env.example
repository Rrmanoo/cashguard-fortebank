# Configure these in the shell; launchers do not auto-load .env.
CUDA_VISIBLE_DEVICES=1
MODEL_URL=http://127.0.0.1:9016/v1
MODEL_NAME=cashier-vlm
# Use an absolute path to each directory in your deployment.
# CASHGUARD_MODELS=/path/to/cashguard/models
# CASHGUARD_DATA=/path/to/cashguard/runtime
# CASHGUARD_EXAMPLES=/path/to/cashguard/examples
# CASHGUARD_API_KEY_FILE=/path/to/private/api.key
